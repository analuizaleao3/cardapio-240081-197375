    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    p.id,\n    p.nome,\n    p.descricao,\n    p.preco,\n    p.em_promocao AS \"emPromocao\",\n    p.preco_promocional AS \"precoPromocional\",\n    p.disponivel,\n    json_agg(\n        json_build_object(\n            'nome', i.nome,\n            'quantidade', pi.quantidade,\n            'unidade', i.unidade\n        )\n        ORDER BY i.id\n    ) AS ingredientes\nFROM turmaa03_cardapio_pizza p\nINNER JOIN turmaa03_cardapio_pizza_ingrediente pi\n    ON pi.pizza_id = p.id\nINNER JOIN turmaa03_cardapio_ingrediente i\n    ON i.id = pi.ingrediente_id\nWHERE p.disponivel = TRUE\nGROUP BY\n    p.id,\n    p.nome,\n    p.descricao,\n    p.preco,\n    p.em_promocao,\n    p.preco_promocional,\n    p.disponivel\nORDER BY p.id;",
