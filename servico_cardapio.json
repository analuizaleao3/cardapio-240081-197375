    {
      "parameters": {
        "jsCode": "// Dados retornados pelo PostgreSQL\nconst pizzas = $('pg_menu_buscar_pizza').all();\n\n// Dados retornados pelo Estoque\nconst estoque = $input.first().json;\n\n// Verifica cada pizza\nconst pizzasDisponiveis = pizzas\n    .map(item => item.json)\n    .filter(pizza => {\n\n        // A pizza precisa estar ativa no Cardápio\n        if (pizza.disponivel !== true) {\n            return false;\n        }\n\n        // Todos os ingredientes precisam existir\n        // em quantidade suficiente no estoque\n        return pizza.ingredientes.every(ingrediente => {\n\n            const estoqueIngrediente = estoque[ingrediente.nome];\n\n            if (!estoqueIngrediente) {\n                return false;\n            }\n\n            return (\n                estoqueIngrediente.unidade === ingrediente.unidade &&\n                estoqueIngrediente.quantidade >= ingrediente.quantidade\n            );\n        });\n    });\n\nif (pizzasDisponiveis.length === 0) {\n    return [\n        {\n            json: {\n                code: 200,\n                message: \"Não há pizzas disponíveis no momento.\",\n                pizzas: []\n            }\n        }\n    ];\n}\n\nreturn pizzasDisponiveis.map(pizza => ({\n    json: {\n      code: 200,\n      pizzas: pizza\n    }\n}));"
      },
